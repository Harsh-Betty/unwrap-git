# GitHub personal access token used for public lookups (no scopes needed).
# https://github.com/settings/tokens
GITHUB_ACCESS_TOKEN=

# GitHub OAuth app for "Sign in with GitHub".
# Callback URL: <your site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# better-auth: a random secret (openssl rand -base64 32) and the site origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Postgres for sign-in sessions and the leaderboard (Supabase works well).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Optional: Upstash Redis for caching and rate limiting. Without it the app
# falls back to in-memory caching, which is fine for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: canonical origin for metadata and the sitemap.
# Defaults to https://unwrap-git.hrshvrdhn.com
NEXT_PUBLIC_SITE_URL=
